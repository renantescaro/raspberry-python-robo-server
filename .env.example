# Rede
SERVER_HOST=0.0.0.0
SERVER_PORT=5001

# Backend de GPIO: auto (pigpio > lgpio > RPi.GPIO), pigpio, lgpio, rpigpio ou mock
GPIO_BACKEND=auto
# Só lgpio: número do gpiochip (vazio = detecta automaticamente)
GPIO_CHIP=

# Motores (numeração BCM)
MOTOR_RIGHT_FORWARD_PIN=27
MOTOR_RIGHT_BACKWARD_PIN=17
MOTOR_LEFT_FORWARD_PIN=4
MOTOR_LEFT_BACKWARD_PIN=3

# Câmera (servos)
SERVO_VERTICAL_PIN=18
SERVO_HORIZONTAL_PIN=23
CAMERA_SPEED_DPS=100
CAMERA_V_MIN_ANGLE=5
CAMERA_V_MAX_ANGLE=135
CAMERA_H_MIN_ANGLE=5
CAMERA_H_MAX_ANGLE=175
CAMERA_V_INVERT=false
CAMERA_H_INVERT=true
# Tempo parado até cortar o pulso do servo (0 = manter sempre)
SERVO_RELEASE_AFTER_S=0.5

# Segurança: para o robô se não chegar nenhum pacote nesse tempo (0 = desativado)
WATCHDOG_TIMEOUT_S=1.0
CONTROL_TICK_S=0.02

# Sensor ultrassônico
ULTRASONIC_ENABLED=false
ULTRASONIC_TRIG_PIN=19
ULTRASONIC_ECHO_PIN=26
ULTRASONIC_RATE_HZ=20

# git pull na inicialização
AUTO_UPDATE=true
AUTO_UPDATE_BRANCH=master
